Bootstrap: docker
From: ubuntu:24.04

# Based on a comsol_ubuntu.def file from Standford University

# Build with source zip file "COMSOL64_lnx.zip" & config file "setupconfig.ini"
# mounted into the container's /COMSOL_build/ directory and the COMSOL license
# file "license.dat" mounted into the container's /COMSOL_build/license/
# directory
#
# For example:
#
#  apptainer build \
#   --build-arg SLURMTMPDIR="${SLURMTMPDIR}" \
#   --bind $(pwd)/COMSOL64_lnx.zip:/COMSOL_build/COMSOL64_lnx.zip:ro \
#   --bind $(pwd)/comsol64-setupconfig.ini:/COMSOL_build/setupconfig.ini:ro \
#   --bind $(pwd)/COMSOL-SENS-license.dat:/COMSOL_build/license/license.dat:ro \
#   COMSOL64-$(arch).sif COMSOL64.def
#

%arguments
    SLURMTMPDIR=""

%files
  matlab_lmutil_x86_64 "/MATLAB/sbin/lmutil"

%setup 
  mkdir "${APPTAINER_ROOTFS}/COMSOL"
  mkdir "${APPTAINER_ROOTFS}/COMSOL_build"
  touch "${APPTAINER_ROOTFS}/COMSOL_build/COMSOL64_lnx.zip"
  touch "${APPTAINER_ROOTFS}/COMSOL_build/setupconfig.ini"
  mkdir "${APPTAINER_ROOTFS}/COMSOL_build/license/"
  touch "${APPTAINER_ROOTFS}/COMSOL_build/license/license.dat"
  mkdir -p "${APPTAINER_ROOTFS}/MATLAB/licenses" \
   "${APPTAINER_ROOTFS}/MATLAB/sbin"
  touch "${APPTAINER_ROOTFS}/MATLAB/licenses/licenses.lic"
  # create mountpoint for /scratch during the build (for ${SLURMTMPDIR})
  mkdir "${APPTAINER_ROOTFS}/scratch"

%post -c /bin/bash

  MATLAB_VERSION="R2025b"
  #UBUNTU_RELEASE="$(/bin/lsb_release -sr 2>/dev/null)"
  UBUNTU_RELEASE="24.04"
  
  # Bail early if the COMSOL source zip file, config file or license file is
  # missing
  # NOTE: the MATLAB license file is not needed for the build
  if ! [ -s "/COMSOL_build/COMSOL64_lnx.zip" ]
  then
    echo "You must bind mount the source zip file with e.g." >&2
    echo "apptainer build --bind \$(pwd)/COMSOL64_lnx.zip:/COMSOL_build/COMSOL64_lnx.zip:ro [...]" >&2 
    exit 1
  fi
  if ! [ -s "/COMSOL_build/setupconfig.ini" ]
  then
    echo "You must bind mount the setupconfig.ini file with e.g." >&2
    echo "apptainer build --bind \$(pwd)/comsol64-setupconfig.ini:/COMSOL_build/setupconfig.ini:ro [...]" >&2
    exit 1
  fi
  if ! [ -s "/COMSOL_build/license/license.dat" ]
  then
    echo "You must bind mount the COMSOL license file to /COMSOL_build/license/license.dat for the build, with e.g." >&2
    echo "apptainer build --bind \$(pwd)/COMSOL-SENS-license.dat:/COMSOL_build/license/license.dat:ro [...]" >&2
    exit 1
  fi

  # Make sure the environment variable TMPDIR is set and that the directory
  # exists
  export SLURMTMPDIR="{{ SLURMTMPDIR }}"
  uid="$(head -1 /proc/self/uid_map | awk '{print $2}')"
  export TMPDIR="${SLURMTMPDIR:-/var/tmp}/tmp_${uid}"
  mkdir -p "${TMPDIR}"

  # Set the timezone, if unset
  test -h /etc/localtime || ln -fs /usr/share/zoneinfo/America/New_York /etc/localtime

  cp /etc/apt/sources.list /etc/apt/sources.list~
  sed -E -i 's/^# deb-src /deb-src /' /etc/apt/sources.list
  apt-get -y update

  # Install man & man pages - this section can be removed if not needed
  # NOTE: Do this before installing anything else so their man pages are installed
  sed -e '\|/usr/share/man|s|^#*|#|g' -i /etc/dpkg/dpkg.cfg.d/excludes
  DEBIAN_FRONTEND=noninteractive apt-get -y install apt-utils groff dialog man-db manpages manpages-posix manpages-dev
  rm -f /usr/bin/man
  dpkg-divert --quiet --remove --rename /usr/bin/man

  # O/S package updates:
  DEBIAN_FRONTEND=noninteractive apt-get -y upgrade

  DEBIAN_FRONTEND=noninteractive apt-get -y install \
   tzdata \
   locales \
   unzip \
   wget \
   gawk \
   build-essential \
   autoconf \
   automake \
   pkg-config \
   gfortran \
   python3 \
   python3-pip \
   python3-setuptools \
   python3-sphinx \
   python3-sphinx-rtd-theme \
   python-is-python3 \
   zstd \
   gnulib \
   libssl-dev \
   zlib1g-dev \
   libbz2-dev \
   libncurses5-dev \
   libncursesw5-dev \
   liblzma-dev \
   liblz4-tool \
   libcurl4-gnutls-dev \
   libdeflate-dev \
   pax-utils \
   libmpfr-dev \
   libgmp3-dev \
   libmpc-dev \
   x11-apps \
   xdg-utils \
   libgtk2.0-dev \
   libgtk-3-dev \
   libgtk-4-dev \
   libxrender1 \
   libxtst6 \
   libxi6 \
   libswt-gtk-4-java \
   libwebkit2gtk-4.1-0 \
   libwebkitgtk-6.0-4 \
   libatomic1 \
   libopengl0 \
   libcublas12 \
   less \
   curl \
   jq \
   nano \
   vim \
   apt-file

  # NOTE: apt-file is generally not needed to run, but can be useful during development
  apt-file update

  # These steps are necessary to configure Perl and can cause issues with Python if omitted
  sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
  dpkg-reconfigure --frontend=noninteractive locales
  update-locale LANG=en_US.UTF-8

  # Install MATLAB dependencies
  curl -L -o "${TMPDIR}/base-dependencies.txt" \
   "https://raw.githubusercontent.com/mathworks-ref-arch/container-images/refs/heads/main/matlab-deps/$(echo "${MATLAB_VERSION}" | tr '[:upper:]' '[:lower:]')/ubuntu${UBUNTU_RELEASE}/base-dependencies.txt"
  apt-get install --no-install-recommends -y $(cat "${TMPDIR}/base-dependencies.txt")
  mkdir -p /usr/share/X11/xkb
  # Install MATLAB
  cd "/MATLAB/sbin"
  curl -L -O https://www.mathworks.com/mpm/glnxa64/mpm
  chmod +x mpm
  # add link for MATLAB's lmstat
  chmod 755 "/MATLAB/sbin/lmutil"
  mkdir -p "/MATLAB/bin"
  ln -s "/MATLAB/sbin/lmutil" "/MATLAB/bin/lmstat"
  export MLM_LICENSE_FILE="/MATLAB/licenses/licenses.lic"
  #
  # MATLAB install options
  #
  # MATLAB minimal install
  #./mpm install --release="${MATLAB_VERSION}" --accept-vendor-licenses --destination=/MATLAB --products=MATLAB
  #
  # Parallel MATLAB minimal install
  #./mpm install --release="${MATLAB_VERSION}" --accept-vendor-licenses --destination=/MATLAB --products=MATLAB Parallel_Computing_Toolbox
  #
  # Intall all packages - based on a list from:
  #   /MATLAB/bin/lmstat -a | grep -E "^Users[[:space:]]+of" | awk '{print $3}' | sed 's/:$//'
  #
  ./mpm install --release="${MATLAB_VERSION}" \
   --destination=/MATLAB \
   --accept-vendor-licenses \
   --products=MATLAB \
   5G_Toolbox \
   AUTOSAR_Blockset \
   Aerospace_Blockset \
   Aerospace_Toolbox \
   Antenna_Toolbox \
   Audio_Toolbox \
   Automated_Driving_Toolbox \
   Bioinformatics_Toolbox \
   Bluetooth_Toolbox \
   C2000_Microcontroller_Blockset \
   Communications_Toolbox \
   Computer_Vision_Toolbox \
   Control_System_Toolbox \
   Curve_Fitting_Toolbox \
   DDS_Blockset \
   DSP_HDL_Toolbox \
   Database_Toolbox \
   Datafeed_Toolbox \
   Deep_Learning_Toolbox \
   Deep_Learning_HDL_Toolbox \
   Econometrics_Toolbox \
   Embedded_Coder \
   Financial_Instruments_Toolbox \
   Fixed-Point_Designer \
   Fuzzy_Logic_Toolbox \
   Financial_Toolbox \
   Global_Optimization_Toolbox \
   GPU_Coder \
   HDL_Coder \
   HDL_Verifier \
   Image_Acquisition_Toolbox \
   Image_Processing_Toolbox \
   Industrial_Communication_Toolbox \
   Instrument_Control_Toolbox \
   LTE_Toolbox \
   Lidar_Toolbox \
   Mapping_Toolbox \
   MATLAB_Coder \
   MATLAB_Compiler \
   MATLAB_Compiler_SDK \
   MATLAB_Report_Generator \
   MATLAB_Test \
   Medical_Imaging_Toolbox \
   Mixed-Signal_Blockset \
   Model_Predictive_Control_Toolbox \
   Motor_Control_Blockset \
   Navigation_Toolbox \
   Optimization_Toolbox \
   Parallel_Computing_Toolbox \
   Partial_Differential_Equation_Toolbox \
   Phased_Array_System_Toolbox \
   Powertrain_Blockset \
   Predictive_Maintenance_Toolbox \
   Reinforcement_Learning_Toolbox \
   Requirements_Toolbox \
   RF_Blockset \
   RF_PCB_Toolbox \
   RF_Toolbox \
   Robotics_System_Toolbox \
   Robust_Control_Toolbox \
   ROS_Toolbox \
   Radar_Toolbox \
   Risk_Management_Toolbox \
   Robotics_System_Toolbox \
   Satellite_Communications_Toolbox \
   Sensor_Fusion_and_Tracking_Toolbox \
   SerDes_Toolbox \
   Signal_Integrity_Toolbox \
   Signal_Processing_Toolbox \
   SimBiology \
   SimEvents \
   Simscape \
   Simscape_Battery \
   Simscape_Driveline \
   Simscape_Fluids \
   Simscape_Multibody \
   Simulink \
   Simulink_3D_Animation \
   Simulink_Check \
   Simulink_Coder \
   Simulink_Compiler \
   Simulink_Control_Design \
   Simulink_Coverage \
   Simulink_Design_Optimization \
   Simulink_Design_Verifier \
   Simulink_Desktop_Real-Time \
   Simscape_Electrical \
   Simulink_Fault_Analyzer \
   Simulink_PLC_Coder \
   Simulink_Real-Time \
   Simulink_Report_Generator \
   Simulink_Test \
   SoC_Blockset \
   Stateflow \
   Statistics_and_Machine_Learning_Toolbox \
   Symbolic_Math_Toolbox \
   System_Composer \
   System_Identification_Toolbox \
   Text_Analytics_Toolbox \
   UAV_Toolbox \
   Vehicle_Dynamics_Blockset \
   Vehicle_Network_Toolbox \
   Vision_HDL_Toolbox \
   WLAN_Toolbox \
   Wavelet_Toolbox \
   Wireless_HDL_Toolbox \
   Wireless_Testbench

  # Install COMSOL
  cd /COMSOL_build
  unzip -q COMSOL64_lnx.zip
  cd COMSOL64_lnx
  cp ../setupconfig.ini .
  # set the MATLAB install dir in the config file:
  sed -E -i 's|matlabdir =.*$|matlabdir = /MATLAB|' setupconfig.ini
  chmod +x setup
  ./setup -s setupconfig.ini

  # Remove the COMSOL licenses from the container image
  mkdir -p "/COMSOL/license/"
  find "/COMSOL/license/" -type f -exec rm {} \;
  # add the bind mount point for the license
  touch "/COMSOL/license/license.dat"

  apt-get -y update
  DEBIAN_FRONTEND=noninteractive apt-get -y upgrade

  # Workround for /COMSOL/ext/mpich2/glnxa64/lib/libmpifort.so.12 library
  # dependency
  ln -s /COMSOL/lib/glnxa64/libgfortran.so.5 /COMSOL/lib/glnxa64/libgfortran.so.3

  # Cleanup
  # unmount the source, config file and license bind mounts
  umount "/COMSOL_build/COMSOL64_lnx.zip" \
   "/COMSOL_build/setupconfig.ini" \
   "/COMSOL_build/license/license.dat"
  cd /
  rm -rf "/COMSOL_build"

%environment
  #
  # The SLURMTMPDIR environment variable is not available in this script, so
  # grab SLURMTMPDIR if it is in /proc/$$/environ
  grep -aq '\"SLURMTMPDIR=' /proc/$$/environ && export SLURMTMPDIR="$(grep -a '\"SLURMTMPDIR=' /proc/$$/environ | sed -E -e 's|^.*\"SLURMTMPDIR=||' -e 's|\".*$||' 
)"
  #
  # Make sure TMPDIR exists and is a directory
  uid="$(head -1 /proc/self/uid_map | awk '{print $2}')"
  export TMPDIR="${SLURMTMPDIR:-/var/tmp}/tmp_${uid}"
  mkdir -p "${TMPDIR}"
  #
  export LC_ALL=C
  #
  export EDITOR=vim
  #
  # MATLAB license (bindmount)
  export MLM_LICENSE_FILE="/MATLAB/licenses/licenses.lic"
  if ! [ -s "${MLM_LICENSE_FILE}"  ]
  then
    echo "WARNING: to use MATLAB you must bind mount the MATLAB license file with e.g." >&2
    echo "apptainer build --bind \$(pwd)/matlab.lic:/MATLAB/licenses/licenses.lic:ro [...]" >&2
  fi
  export PATH=/COMSOL/bin:/MATLAB/bin:$PATH

%runscript
  #!/bin/bash
  export PS1="COMSOL$ "
  # Exec passed command (required for Modal ENTRYPOINT compatibility)
  exec "$@"

